{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "module": "None",
    "strict": false,
    "noEmitOnError": true,
    "removeComments": false,
    "sourceMap": false,
    "outDir": "build-client",
    "rootDir": "src/client",
    "skipLibCheck": true
  },
  "include": ["src/client/**/*.ts"]
}
